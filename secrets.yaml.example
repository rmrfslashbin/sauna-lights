# Secrets Configuration Template
# CRITICAL: Copy this file to secrets.yaml and fill in your credentials
# NEVER commit secrets.yaml to version control!

# WiFi Configuration
# Use 2.4GHz network only (ESP32 doesn't support 5GHz)
wifi_ssid: "Your_WiFi_SSID"
wifi_password: "your_wifi_password"

# Fallback Access Point (when WiFi fails)
# This creates a backup hotspot to connect to the device
ap_password: "fallback_ap_password"

# API Encryption Key
# Generate with: openssl rand -base64 32
# This key encrypts communication with Home Assistant
api_encryption_key: "generate_with_openssl_rand_base64_32"

# OTA Update Password
# Generate with: openssl rand -hex 16
# Used to authenticate over-the-air firmware updates
ota_password: "generate_with_openssl_rand_hex_16"

# Web Server Authentication (optional)
# web_username: "admin"
# web_password: "your_web_password"
